# Placeholder names only — never commit real values.
DATABASE_URL=postgres://nexus:nexus@127.0.0.1:5432/nexus
API_HOST=127.0.0.1
API_PORT=8787
# Origin in the browser address bar (Tailscale Serve URL remotely, http://localhost:5173 with Vite dev);
# <PUBLIC_ORIGIN>/api/auth/callback/github must be a callback URL of the GitHub App (docs/runbooks/github-setup.md)
PUBLIC_ORIGIN=http://127.0.0.1:8787
BETTER_AUTH_SECRET=
# NEXUS GitHub App (Sign in with GitHub + repo access), written by `pnpm --filter @nexus/api github:setup`
GITHUB_APP_FILE=~/.nexus/github-app.json
# Runner -> API
NEXUS_API_URL=http://127.0.0.1:8787
RUNNER_TOKEN_FILE=~/.nexus/runner-token
# AI provider for P1 chat/voice: anthropic | foundry (see PRD Part A)
AI_PROVIDER=anthropic
# The runner's coding engine reads its provider + key from ~/.nexus/ai.json (mode 0600), not from env:
# see docs/runbooks/ai-provider.md
# Runner data dir: bare mirrors (repos/<owner>/<name>.git) and per-job worktrees (work/<jobId>)
RUNNER_DATA_DIR=~/.nexus
# Job isolation: docker (default, one container per run) | none (dev/test only: runs on the host, no isolation)
RUNNER_SANDBOX=docker
