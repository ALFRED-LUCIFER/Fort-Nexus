{
  "name": "nexus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test && node --test \"scripts/*.test.mjs\"",
    "format": "prettier --write .",
    "db:up": "docker compose -f infra/compose/docker-compose.yml up -d postgres",
    "nexus": "node scripts/nexus.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:drill": "node scripts/restore-drill.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
